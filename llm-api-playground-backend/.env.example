# Server
PORT=5000

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# CORS — comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Rate limiting — general limit for all /api routes (per IP)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# Rate limiting — stricter limit for LLM generation routes (per IP)
LLM_RATE_LIMIT_WINDOW_MS=60000
LLM_RATE_LIMIT_MAX=10

# Input limits (characters)
MAX_PROMPT_LENGTH=8000
MAX_SYSTEM_PROMPT_LENGTH=4000

# Set to 1 when running behind a reverse proxy / load balancer
# TRUST_PROXY=1
